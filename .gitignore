## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto-generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Re]leases/
x64/
x86/
[Aa]rm/
[Aa]rm64/
bld/
[Bb]in/
[Oo]bj/
[Log]s/
[Ff]ormats/

# Visual Studio 2015/2017/2019/2022 cache directory
.vs/

# Uninstall target
Uninstaller

# path for database
App_Data/

# Tools
_ReSharper*/
*.[Re]Sharper
*.DotSettings.user

# Rider
.idea/

# Visual Studio Code
.vscode/

# System Files
.DS_Store
Thumbs.db

# Project specific upload files (Exclude locally uploaded attachments)
**/wwwroot/uploads/

# Temporary and local test files in root
/test.js
/test.py
/frappe-gantt.css
/other/
/publish/
/*.txt

