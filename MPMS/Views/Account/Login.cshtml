@model MPMS.Models.LoginViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>登入 - MPMS 多專案管理系統</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Noto+Sans+TC:wght@300;400;500;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --bg-gradient: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%);
            --accent-primary: #6366f1;
            --accent-secondary: #4f46e5;
            --text-light: #f8fafc;
            --text-muted: #94a3b8;
            --glass-bg: rgba(30, 41, 59, 0.7);
            --glass-border: rgba(255, 255, 255, 0.08);
        }

        body {
            font-family: 'Outfit', 'Noto Sans TC', sans-serif;
            background: var(--bg-gradient);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-light);
            margin: 0;
            overflow-x: hidden;
            position: relative;
        }

        /* Ambient background glow */
        .glow-sphere-1 {
            position: absolute;
            width: 400px;
            height: 400px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(99, 102, 241, 0.15) 0%, rgba(0,0,0,0) 70%);
            top: -100px;
            left: -100px;
            z-index: 0;
        }

        .glow-sphere-2 {
            position: absolute;
            width: 500px;
            height: 500px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(79, 70, 229, 0.12) 0%, rgba(0,0,0,0) 70%);
            bottom: -150px;
            right: -100px;
            z-index: 0;
        }

        .login-container {
            width: 100%;
            max-width: 460px;
            padding: 20px;
            z-index: 10;
        }

        .login-card {
            background: var(--glass-bg);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--glass-border);
            border-radius: 24px;
            padding: 40px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .login-card:hover {
            box-shadow: 0 24px 48px rgba(99, 102, 241, 0.15);
        }

        .brand-header {
            text-align: center;
            margin-bottom: 35px;
        }

        .brand-logo {
            font-size: 3rem;
            font-weight: 700;
            background: linear-gradient(135deg, #a5b4fc 0%, #6366f1 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 8px;
            letter-spacing: -1px;
            display: inline-block;
        }

        .brand-title {
            font-size: 1.25rem;
            font-weight: 500;
            color: var(--text-light);
            margin: 0;
        }

        .brand-subtitle {
            font-size: 0.875rem;
            color: var(--text-muted);
            margin-top: 5px;
        }

        .form-label {
            font-size: 0.85rem;
            font-weight: 500;
            color: #cbd5e1;
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .input-group-custom {
            position: relative;
            margin-bottom: 24px;
        }

        .form-control-custom {
            width: 100%;
            background: rgba(15, 23, 42, 0.6) !important;
            border: 1px solid var(--glass-border);
            border-radius: 12px;
            padding: 12px 16px;
            color: var(--text-light) !important;
            font-size: 0.95rem;
            transition: all 0.2s ease;
        }

        .form-control-custom:focus {
            outline: none;
            border-color: var(--accent-primary);
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.25);
            background: rgba(15, 23, 42, 0.8) !important;
        }

        .form-control-custom::placeholder {
            color: #64748b;
        }

        .remember-forgot {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 28px;
            font-size: 0.875rem;
        }

        .form-check-input-custom {
            background-color: rgba(15, 23, 42, 0.6);
            border: 1px solid var(--glass-border);
            cursor: pointer;
            width: 16px;
            height: 16px;
        }

        .form-check-input-custom:checked {
            background-color: var(--accent-primary);
            border-color: var(--accent-primary);
        }

        .form-check-label {
            color: #cbd5e1;
            cursor: pointer;
            user-select: none;
            padding-left: 4px;
        }

        .btn-submit {
            width: 100%;
            background: linear-gradient(135deg, var(--accent-primary) 0%, var(--accent-secondary) 100%);
            border: none;
            border-radius: 12px;
            padding: 14px;
            color: white;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s ease;
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
        }

        .btn-submit:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 18px rgba(99, 102, 241, 0.4);
        }

        .btn-submit:active {
            transform: translateY(1px);
        }

        .error-message {
            background: rgba(239, 68, 68, 0.15);
            border: 1px solid rgba(239, 68, 68, 0.3);
            border-radius: 12px;
            padding: 12px 16px;
            font-size: 0.875rem;
            color: #fca5a5;
            margin-bottom: 24px;
        }

        .error-message ul {
            margin: 0;
            padding-left: 20px;
        }

        .demo-accounts {
            margin-top: 30px;
            background: rgba(15, 23, 42, 0.4);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 16px;
            padding: 16px 20px;
            font-size: 0.8rem;
        }

        .demo-title {
            color: #cbd5e1;
            font-weight: 600;
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-size: 0.75rem;
        }

        .demo-item {
            display: flex;
            justify-content: space-between;
            color: var(--text-muted);
            margin-bottom: 4px;
        }
        
        .demo-item:last-child {
            margin-bottom: 0;
        }

        .demo-role {
            color: #818cf8;
            font-weight: 500;
        }

        .demo-cred {
            font-family: monospace;
            color: #e2e8f0;
        }
    </style>
</head>
<body>

    <div class="glow-sphere-1"></div>
    <div class="glow-sphere-2"></div>

    <div class="login-container">
        <div class="login-card">
            
            <div class="brand-header">
                <div class="brand-logo">MPMS</div>
                <h1 class="brand-title">多專案管理系統</h1>
                <p class="brand-subtitle">Multi Project Management System</p>
            </div>

            <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="error-message">
                        <div asp-validation-summary="All"></div>
                    </div>
                }

                <div class="input-group-custom">
                    <label asp-for="Account" class="form-label"></label>
                    <input asp-for="Account" class="form-control-custom" placeholder="請輸入登入帳號" autocomplete="username" required />
                    <span asp-validation-for="Account" class="text-danger" style="font-size:0.8rem; margin-top:4px; display:block;"></span>
                </div>

                <div class="input-group-custom">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control-custom" placeholder="請輸入登入密碼" autocomplete="current-password" required />
                    <span asp-validation-for="Password" class="text-danger" style="font-size:0.8rem; margin-top:4px; display:block;"></span>
                </div>

                <div class="remember-forgot">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input form-check-input-custom" />
                        <label asp-for="RememberMe" class="form-check-label"></label>
                    </div>
                    <a href="javascript:void(0);" onclick="alert('若忘記密碼，請直接聯繫系統管理員 (Admin) 為您強制重設密碼。')" style="color: var(--accent-primary); text-decoration: none; font-weight: 500; transition: color 0.2s ease;" onmouseover="this.style.color='var(--accent-secondary)'" onmouseout="this.style.color='var(--accent-primary)'">忘記密碼？</a>
                </div>

                <button type="submit" class="btn-submit">安全登入</button>
            </form>

            <div class="demo-accounts">
                <div class="demo-title">測試登入帳號資訊</div>
                <div class="demo-item">
                    <span><span class="demo-role">系統管理員</span> (Admin)</span>
                    <span class="demo-cred">admin / Password123</span>
                </div>
                <div class="demo-item">
                    <span><span class="demo-role">專案經理</span> (PM)</span>
                    <span class="demo-cred">pm1 / Password123</span>
                </div>
                <div class="demo-item">
                    <span><span class="demo-role">一般人員</span> (Employee)</span>
                    <span class="demo-cred">emp1 / Password123</span>
                </div>
            </div>

        </div>
    </div>

</body>
</html>
