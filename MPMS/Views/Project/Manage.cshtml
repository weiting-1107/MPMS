@model IEnumerable<MPMS.Models.Project>
@{
    ViewData["Title"] = "專案管理";
}

<!-- Notification Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-4 mb-4" role="alert">
        <strong>✨ 成功：</strong>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-4 mb-4" role="alert">
        <strong>⚠️ 警告：</strong>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-transparent border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
        <div>
            <h4 class="card-title fw-bold text-dark mb-1">專案管理</h4>
            <p class="text-muted small mb-0">維護專案基礎資料、手動更新專案整體進度，以及管理專案下轄里程碑</p>
        </div>
        <div class="d-flex gap-2">
            <a href="/Project" class="btn btn-outline-dark rounded-3 px-3 py-2">
                🔍 全局專案看板
            </a>
            <a href="/Project/Create" class="btn btn-primary rounded-3 px-3 py-2">
                ➕ 新建專案
            </a>
        </div>
    </div>
    
    <div class="card-body px-4 pb-4">
        <hr class="mt-0 mb-4">
        
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>專案代號</th>
                        <th>專案名稱</th>
                        <th>專案經理 (PM)</th>
                        <th>專案期程</th>
                        <th>手動進度 (%)</th>
                        <th>專案狀態</th>
                        <th class="text-end">操作功能</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var proj in Model)
                    {
                        <tr>
                            <td><span class="badge bg-light text-dark border px-2.5 py-1.5 rounded-pill fw-semibold">@proj.ProjectCode</span></td>
                            <td class="fw-bold text-dark" style="word-break: break-all; max-width: 300px;">@proj.ProjectName</td>
                            <td>@proj.PmUserName</td>
                            <td class="small">
                                @proj.StartDate.ToString("yyyy-MM-dd")<br>
                                <span class="text-muted">至</span> @proj.EndDate.ToString("yyyy-MM-dd")
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="fw-bold text-primary">@proj.ManualProgressPct.ToString("0")%</span>
                                    <div class="progress rounded-pill d-none d-md-flex" style="width: 60px; height: 6px;">
                                        <div class="progress-bar rounded-pill" role="progressbar" style="width: @proj.ManualProgressPct% ; background-color: #4f46e5;" aria-valuenow="@proj.ManualProgressPct" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @if (proj.ProjectStatus == "Active")
                                {
                                    <span class="badge bg-success px-2.5 py-1.5 rounded-3">進行中 (Active)</span>
                                }
                                else if (proj.ProjectStatus == "Planning")
                                {
                                    <span class="badge bg-warning text-dark px-2.5 py-1.5 rounded-3">規劃中 (Planning)</span>
                                }
                                else if (proj.ProjectStatus == "Hold")
                                {
                                    <span class="badge bg-danger px-2.5 py-1.5 rounded-3">暫停 (Hold)</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-2.5 py-1.5 rounded-3">已結案 (Closed)</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group gap-1">
                                    <a href="/Gantt?projectId=@proj.ProjectId" class="btn btn-sm btn-outline-info rounded-2" title="甘特圖檢視">
                                        📊 甘特圖
                                    </a>
                                    <a href="/Project/Edit/@proj.ProjectId" class="btn btn-sm btn-outline-secondary rounded-2" title="編輯專案基本資料">
                                        ✏️ 編輯
                                    </a>
                                    <a href="/Project/AdjustProgress/@proj.ProjectId" class="btn btn-sm btn-outline-primary rounded-2" title="手動調整專案進度">
                                        📈 調整進度
                                    </a>
                                    <a href="/Project/Phases?projectId=@proj.ProjectId" class="btn btn-sm btn-outline-dark rounded-2" title="維護下轄階段">
                                        📍 階段
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger rounded-2"
                                            onclick="confirmDeleteProject(@proj.ProjectId, '@Html.Raw(proj.ProjectName.Replace("'", "\\'"))', '@proj.ProjectCode')">
                                        🗑️ 刪除
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (User.IsInRole("ADMIN") || User.IsInRole("PM"))
{
    <!-- Delete Project Confirmation Modal -->
    <div class="modal fade" id="deleteProjectModal" tabindex="-1" aria-labelledby="deleteProjectModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 16px;">
                <div class="modal-header border-bottom-0 bg-danger text-white" style="border-radius: 16px 16px 0 0;">
                    <h5 class="modal-title fw-bold" id="deleteProjectModalLabel">🗑️ 確認刪除專案</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-4">
                    <p class="text-muted mb-1">您確定要刪除以下專案嗎？此操作無法還原！</p>
                    <div class="alert alert-warning border-0 shadow-sm">
                        <div class="fw-bold fs-6" id="deleteProjectCodeName"></div>
                    </div>
                    <p class="text-danger small fw-semibold mb-0">⚠️ 警告：這將會同時刪除該專案下所有專案階段、工作任務、相關簽核歷程、附件與歷程軌跡！</p>
                </div>
                <div class="modal-footer border-top-0">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">取消</button>
                    <form id="deleteProjectForm" asp-action="DeleteProject" method="post" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="projectId" id="deleteProjectIdInput" value="" />
                        <button type="submit" class="btn btn-danger rounded-pill px-4">🗑️ 確認刪除</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

<script>
    function confirmDeleteProject(projectId, projectName, projectCode) {
        document.getElementById('deleteProjectIdInput').value = projectId;
        document.getElementById('deleteProjectCodeName').textContent = '[' + projectCode + '] ' + projectName;
        new bootstrap.Modal(document.getElementById('deleteProjectModal')).show();
    }
</script>

