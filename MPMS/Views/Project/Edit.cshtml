@model MPMS.Models.Project
@{
    ViewData["Title"] = "編輯專案";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-transparent border-0 pt-4 px-4">
                <h4 class="card-title fw-bold text-dark mb-1">編輯專案</h4>
                <p class="text-muted small mb-0">修改專案基本內容、狀態或專案經理 (PM)</p>
            </div>
            
            <div class="card-body px-4 pb-4">
                <hr class="mt-0 mb-4">
                
                <form asp-action="Edit" method="post">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger rounded-3" role="alert">
                            <div asp-validation-summary="All"></div>
                        </div>
                    }

                    <input type="hidden" asp-for="ProjectId" />
                    <input type="hidden" asp-for="ProjectCode" />

                    <div class="row g-3">
                        <!-- Project Code (Readonly) -->
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">專案代號 (不可修改)</label>
                            <input class="form-control rounded-3 bg-light" value="@Model.ProjectCode" disabled />
                        </div>

                        <!-- Project Name -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="ProjectName" class="form-label fw-semibold"></label>
                            <input asp-for="ProjectName" class="form-control rounded-3" placeholder="例如: 全新 CRM 系統開發專案" required />
                            <span asp-validation-for="ProjectName" class="text-danger small"></span>
                        </div>

                        <!-- PM User Id -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="PmUserId" class="form-label fw-semibold"></label>
                            <select asp-for="PmUserId" asp-items="ViewBag.PmCandidates" class="form-select rounded-3" required></select>
                            <span asp-validation-for="PmUserId" class="text-danger small"></span>
                        </div>

                        <!-- Status -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="ProjectStatus" class="form-label fw-semibold"></label>
                            <select asp-for="ProjectStatus" class="form-select rounded-3" required>
                                <option value="Planning">規劃中 (Planning)</option>
                                <option value="Active">進行中 (Active)</option>
                                <option value="Hold">暫停 (Hold)</option>
                                <option value="Closed">已結案 (Closed)</option>
                            </select>
                            <span asp-validation-for="ProjectStatus" class="text-danger small"></span>
                        </div>

                        <!-- Start Date -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="StartDate" class="form-label fw-semibold"></label>
                            <input asp-for="StartDate" type="date" class="form-control rounded-3" required />
                            <span asp-validation-for="StartDate" class="text-danger small"></span>
                        </div>

                        <!-- End Date -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="EndDate" class="form-label fw-semibold"></label>
                            <input asp-for="EndDate" type="date" class="form-control rounded-3" required />
                            <span asp-validation-for="EndDate" class="text-danger small"></span>
                        </div>

                        <!-- Project Desc -->
                        <div class="col-12 mb-3">
                            <label asp-for="ProjectDesc" class="form-label fw-semibold"></label>
                            <textarea asp-for="ProjectDesc" class="form-control rounded-3" rows="4" placeholder="請輸入專案主要目標、範圍與說明..."></textarea>
                            <span asp-validation-for="ProjectDesc" class="text-danger small"></span>
                        </div>

                        <!-- Is Active -->
                        <div class="col-md-6 mb-3 d-flex align-items-center">
                            <div class="form-check form-switch mt-3">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="isActiveSwitch">
                                <label class="form-check-label fw-semibold" for="isActiveSwitch">啟用此專案</label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a href="/Project/Manage" class="btn btn-outline-secondary rounded-3 px-4 py-2">取消</a>
                        <button type="submit" class="btn btn-primary rounded-3 px-4 py-2">確認修改</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
