@model IEnumerable<MPMS.Models.User>
@{
    ViewData["Title"] = "使用者管理";
}

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-transparent border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
        <div>
            <h4 class="card-title fw-bold text-dark mb-1">使用者管理</h4>
            <p class="text-muted small mb-0">管理系統中的使用者帳號、角色權限與啟用狀態</p>
        </div>
        <div>
            <a href="/Admin/CreateUser" class="btn btn-primary rounded-3 px-3 py-2">
                ➕ 新增使用者
            </a>
        </div>
    </div>
    
    <div class="card-body px-4 pb-4">
        <hr class="mt-0 mb-4">
        
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>使用者 ID</th>
                        <th>帳號 (Account)</th>
                        <th>姓名 (Name)</th>
                        <th>電子郵件 (Email)</th>
                        <th>系統角色</th>
                        <th>啟用狀態</th>
                        <th>最後登入時間</th>
                        <th class="text-end">操作</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="fw-bold text-secondary">#@user.UserId</td>
                            <td><span class="badge bg-light text-dark border px-2.5 py-1.5 rounded-pill">@user.Account</span></td>
                            <td class="fw-semibold">@user.UserName</td>
                            <td>@user.Email</td>
                            <td>
                                @if (user.RoleCode == "ADMIN")
                                {
                                    <span class="badge bg-danger-subtle text-danger px-2.5 py-1.5 rounded-pill" style="color: #ef4444 !important; background-color: #fee2e2 !important;">系統管理員</span>
                                }
                                else if (user.RoleCode == "PM")
                                {
                                    <span class="badge bg-primary-subtle text-primary px-2.5 py-1.5 rounded-pill" style="color: #3b82f6 !important; background-color: #dbeafe !important;">專案經理</span>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success px-2.5 py-1.5 rounded-pill" style="color: #10b981 !important; background-color: #d1fae5 !important;">一般人員</span>
                                }
                            </td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success px-2 py-1 rounded-3">使用中</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-2 py-1 rounded-3">已停用</span>
                                }
                            </td>
                            <td class="text-muted small">
                                @(user.LastLoginAt.HasValue ? user.LastLoginAt.Value.ToString("yyyy-MM-dd HH:mm:ss") : "無登入紀錄")
                            </td>
                            <td class="text-end">
                                <a href="/Admin/EditUser/@user.UserId" class="btn btn-sm btn-outline-secondary rounded-2">
                                    編輯
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
