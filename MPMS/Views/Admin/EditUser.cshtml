@model MPMS.Models.User
@{
    ViewData["Title"] = "編輯使用者";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-transparent border-0 pt-4 px-4">
                <h4 class="card-title fw-bold text-dark mb-1">編輯使用者</h4>
                <p class="text-muted small mb-0">修改使用者基本資料、系統角色與啟用狀態</p>
            </div>
            
            <div class="card-body px-4 pb-4">
                <hr class="mt-0 mb-4">
                
                <form asp-action="EditUser" method="post">
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger rounded-3" role="alert">
                            <div asp-validation-summary="All"></div>
                        </div>
                    }

                    <input type="hidden" asp-for="UserId" />
                    <!-- Account value preserved via hidden field so we don't lose it if browser doesn't send disabled inputs -->
                    <input type="hidden" asp-for="Account" />

                    <div class="row g-3">
                        <!-- Account (Disabled for edit) -->
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">登入帳號 (不可修改)</label>
                            <input class="form-control rounded-3 bg-light" value="@Model.Account" disabled />
                        </div>

                        <!-- User Name -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="UserName" class="form-label fw-semibold">使用者姓名</label>
                            <input asp-for="UserName" class="form-control rounded-3" placeholder="例如: 王小明" required />
                            <span asp-validation-for="UserName" class="text-danger small"></span>
                        </div>

                        <!-- Email -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="Email" class="form-label fw-semibold">電子郵件 (Email)</label>
                            <input asp-for="Email" type="email" class="form-control rounded-3" placeholder="例如: xiaoming@example.com" required />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <!-- Role -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="RoleId" class="form-label fw-semibold">系統角色</label>
                            <select asp-for="RoleId" asp-items="ViewBag.Roles" class="form-select rounded-3" required></select>
                            <span asp-validation-for="RoleId" class="text-danger small"></span>
                        </div>

                        <!-- IsActive -->
                        <div class="col-md-6 mb-3 d-flex align-items-center">
                            <div class="form-check form-switch mt-3">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="isActiveSwitch">
                                <label class="form-check-label fw-semibold" for="isActiveSwitch">啟用此帳號</label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a href="/Admin/Users" class="btn btn-outline-secondary rounded-3 px-4 py-2">取消</a>
                        <button type="submit" class="btn btn-primary rounded-3 px-4 py-2">確認修改</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
