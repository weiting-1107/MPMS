                        </div>

                        <!-- Checklist Status Block inside Modal -->
                        <div class="mb-3">
                            <label class="form-label fw-bold small text-dark">📋 工作事項檢核狀態 (@task.ChecklistDoneCount/@task.ChecklistCount)</label>
                            <div id="review-checklist-container-@task.TaskId" class="border rounded-3 p-2 bg-white small" style="max-height: 150px; overflow-y: auto;">
                                <div class="text-center py-2 text-muted small">載入中...</div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-dark">審查結果判定</label>
                            <div class="d-flex gap-2">
                                <input type="radio" class="btn-check" name="reviewResult" id="btnApprove-@task.TaskId" value="Approved" checked autocomplete="off">
                                <label class="btn btn-sm btn-outline-success w-50 rounded-3" for="btnApprove-@task.TaskId">✔️ 通過 (Done)</label>

                                <input type="radio" class="btn-check" name="reviewResult" id="btnReject-@task.TaskId" value="Rejected" autocomplete="off">
                                <label class="btn btn-sm btn-outline-danger w-50 rounded-3" for="btnReject-@task.TaskId">❌ 退回 (Reject)</label>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="reviewComment-@task.TaskId" class="form-label small fw-semibold text-dark">審查意見 / 退回原因 (必填)</label>
                            <textarea id="reviewComment-@task.TaskId" name="reviewComment" class="form-control form-control-sm rounded-3" rows="3" placeholder="請說明同意通過的理由或需修正退回的原因..." required></textarea>
                        </div>
