@section Scripts {
    <script>
        $(document).ready(function() {
            // Peer Review Modal Checklist Loader
            $('[id^="peerReviewModal-"]').on('show.bs.modal', function() {
                var modalId = $(this).attr('id');
                var taskId = modalId.split('-')[1];
                var container = $('#review-checklist-container-' + taskId);
                
                container.html('<div class="text-center py-2 text-muted small"><div class="spinner-border spinner-border-sm me-2" role="status"></div>載入中...</div>');
                
                $.getJSON('/Checklist/GetChecklists?taskId=' + taskId, function(res) {
                    if (res.success && res.data) {
                        var checklists = res.data;
                        container.empty();
                        
                        if (checklists.length === 0) {
                            container.html('<div class="text-center py-2 text-muted small">此任務無任何檢核項目。</div>');
                            return;
                        }

                        checklists.forEach(function(item) {
                            var isDone = item.isDone;
                            var checkedMark = isDone ? '🟢' : '⚪';
                            var textStyle = isDone ? 'text-decoration: line-through; color: #6c757d;' : 'font-weight: 500;';
                            var badge = item.assignedUserName ? `<span class="badge bg-light text-primary border ms-2 fw-normal" style="font-size: 0.7rem;">${item.assignedUserName}</span>` : '';
                            
                            container.append(`
                                <div class="d-flex align-items-center justify-content-between py-1 border-bottom border-light-subtle">
                                    <div class="d-flex align-items-center text-truncate">
                                        <span class="me-2">${checkedMark}</span>
                                        <span style="${textStyle}" class="text-truncate">${escapeHtml(item.checklistTitle)}</span>
                                    </div>
                                    <div class="text-nowrap ms-2">
                                        ${badge}
                                    </div>
                                </div>
                            `);
                        });
                    } else {
                        container.html('<div class="text-center py-2 text-danger small">載入失敗。</div>');
                    }
                }).fail(function() {
                    container.html('<div class="text-center py-2 text-danger small">系統錯誤，載入失敗。</div>');
                });
            });

            // Task Checklist Modal Handler
            $('#taskChecklistModal').on('show.bs.modal', function(event) {
                var button = $(event.relatedTarget);
                var taskId = button.data('task-id');
                var taskTitle = button.data('task-title');
                
                var modal = $(this);
                modal.find('#tcl-modal-task-title').text('📌 ' + taskTitle);
                
                var container = modal.find('#tcl-modal-container');
                var progressBar = modal.find('#tcl-modal-progress-bar');
                
                container.html('<div class="text-center py-4 text-muted small"><div class="spinner-border spinner-border-sm me-2" role="status"></div>載入中...</div>');
                progressBar.css('width', '0%');

                $.getJSON('/Checklist/GetChecklists?taskId=' + taskId, function(res) {
                    if (res.success && res.data) {
                        var checklists = res.data;
                        container.empty();
                        
                        if (checklists.length === 0) {
                            container.html('<div class="text-center py-4 text-muted small">此任務無任何檢核工作事項。</div>');
                            progressBar.css('width', '0%');
                            return;
                        }

                        var doneCount = 0;
                        checklists.forEach(function(item) {
                            var isDone = item.isDone;
                            if (isDone) doneCount++;
                            
                            var checkedMark = isDone ? '🟢' : '⚪';
                            var titleStyle = isDone ? 'text-decoration: line-through; color: #6c757d;' : 'font-weight: 500;';
                            var badges = '';
                            
                            if (item.assignedUserName) {
                                badges += `<span class="badge bg-light text-primary border ms-2 fw-normal">${item.assignedUserName}</span>`;
                            }
                            if (item.dueDate) {
                                badges += `<span class="badge bg-light text-dark border ms-2 fw-normal">${item.dueDate.substring(0, 10)}</span>`;
                            }

                            var itemHtml = `
                                <div class="list-group-item px-2 py-2.5 border-0 border-bottom d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center text-truncate">
                                        <span class="me-2">${checkedMark}</span>
                                        <span style="${titleStyle}" class="text-truncate">${escapeHtml(item.checklistTitle)}</span>
                                        ${badges}
                                    </div>
                                    ${item.checklistDesc ? `<span class="text-muted small text-truncate ms-2" style="max-width: 150px;" title="${escapeHtml(item.checklistDesc)}">${escapeHtml(item.checklistDesc)}</span>` : ''}
                                </div>
                            `;
                            container.append(itemHtml);
                        });

                        var pct = Math.round((doneCount / checklists.length) * 100);
                        progressBar.css('width', pct + '%');
                    } else {
                        container.html('<div class="text-center py-4 text-danger small">載入失敗。</div>');
                    }
                }).fail(function() {
                    container.html('<div class="text-center py-4 text-danger small">系統錯誤，載入失敗。</div>');
                });
            });

            function escapeHtml(unsafe) {
                if (!unsafe) return "";
                return unsafe
                     .replace(/&/g, "&amp;")
                     .replace(/</g, "&lt;")
                     .replace(/>/g, "&gt;")
                     .replace(/"/g, "&quot;")
                     .replace(/'/g, "&#039;");
            }

            // Register event to load comments when comments modal is opened
            $('[id^="commentModal-"]').on('show.bs.modal', function() {
                var modalId = $(this).attr('id');
                var blockId = modalId.split('-')[1];
                var container = $('#comments-container-' + blockId);

                container.html('<div class="text-center py-3 text-muted small"><div class="spinner-border spinner-border-sm me-2" role="status"></div>讀取留言歷程中...</div>');

                $.getJSON('/Block/GetCommentsJson?blockId=' + blockId, function(data) {
                    container.empty();
                    if (!data || data.length === 0) {
                        container.html('<div class="text-center py-3 text-muted small">尚無處理留言紀錄。</div>');
                        return;
                    }
                    
                    data.forEach(function(item) {
                        var date = new Date(item.createdAtUtc);
                        var formattedDate = date.getFullYear() + '-' + 
                                            String(date.getMonth() + 1).padStart(2, '0') + '-' + 
                                            String(date.getDate()).padStart(2, '0') + ' ' + 
                                            String(date.getHours()).padStart(2, '0') + ':' + 
                                            String(date.getMinutes()).padStart(2, '0');
                        
                        var typeClass = "bg-secondary";
                        var typeLabel = "留言";
                        if (item.commentType === 'StatusChange') {
                            typeClass = "bg-danger";
                            typeLabel = "狀態變更";
                        } else if (item.commentType === 'Assignment') {
                            typeClass = "bg-success";
                            typeLabel = "指派";
                        } else if (item.commentType === 'Resolve') {
                            typeClass = "bg-info text-dark";
                            typeLabel = "排除";
                        } else if (item.commentType === 'WeeklyFocus') {
                            typeClass = "bg-warning text-dark";
                            typeLabel = "週會焦點";
                        }

                        var itemHtml = `
                            <div class="mb-2.5 pb-2 border-bottom">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <div>
                                        <span class="badge ${typeClass} me-1.5">${typeLabel}</span>
                                        <strong class="text-dark small">${item.creatorName}</strong>
                                    </div>
                                    <span class="text-muted font-monospace" style="font-size: 0.75rem;">${formattedDate}</span>
                                </div>
                                <div class="small text-secondary" style="white-space: pre-wrap;">${item.commentText}</div>
                            </div>
                        `;
                        container.append(itemHtml);
                    });

                    // Scroll to bottom
                    var scrollTimeline = container.parent();
                    scrollTimeline.scrollTop(scrollTimeline[0].scrollHeight);
                }).fail(function() {
                    container.html('<div class="text-center py-3 text-danger small">讀取失敗。</div>');
                });
            });
        });

        function exportReport(reportName, format) {
            var form = $('#filterForm');
            var serialized = form.serialize();
            var url = '/Block/' + (format === 'csv' ? 'Export' : 'Print') + reportName + '?' + serialized;
            if (format === 'print') {
                window.open(url, '_blank');
            } else {
                window.location.href = url;
            }
        }
    </script>
}
